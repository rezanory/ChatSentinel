{
  "manifest_version": 3,
  "name": "ChatSentinel",
  "version": "1.2.1",
  "description": "Production watchdog, multi-project console and recovery controller for long-running ChatGPT project work.",
  "permissions": [
    "storage",
    "tabs",
    "tabGroups",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "components/conversation-window/trimmer.js",
        "components/conversation-window/page-proxy.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "components/conversation-window/controller.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "components/runtime-context-guard/controller.js",
        "components/tab-launch-guard/controller.js",
        "components/message-delivery-recovery/controller.js",
        "components/prompt-delivery/controller.js",
        "components/response-completion-recovery/controller.js",
        "identity.js",
        "actuator.js",
        "content.js",
        "components/project-chat-lifecycle/controller.js",
        "project-console.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open ChatSentinel in this ChatGPT tab"
  },
  "key": ""
}
