{
  "manifest_version": 3,
  "name": "ChatSentinel",
  "version": "1.0.0",
  "description": "Production watchdog and recovery controller for long-running ChatGPT project work.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "actuator.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ChatSentinel",
    "default_popup": "popup.html"
  },
  "key": ""
}
