{
  "manifest_version": 3,
  "name": "ChatSentinel",
  "version": "0.2.0",
  "description": "Detects ChatGPT stalls, interruptions and recovery states for the local ChatSentinel watchdog.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1:4317/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["actuator.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ChatSentinel"
  }
}
